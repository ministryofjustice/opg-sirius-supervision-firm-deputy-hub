{
  "consumer": {
    "name": "sirius-supervision-firm-deputy-hub"
  },
  "interactions": [
    {
      "description": "A request to change a firms ECM",
      "pending": false,
      "providerStates": [
        {
          "name": "I am an allocations user"
        }
      ],
      "request": {
        "body": {
          "content": {
            "ecmId": 78
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Accept": [
            "application/json"
          ],
          "Content-Type": [
            "application/json"
          ],
          "OPG-Bypass-Membrane": [
            "1"
          ],
          "X-XSRF-TOKEN": [
            "abcde"
          ]
        },
        "matchingRules": {
          "body": {
            "$.ecmId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "X-XSRF-TOKEN": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "PUT",
        "path": "/supervision-api/v1/firms/1/ecm"
      },
      "response": {
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "A request to edit PII",
      "pending": false,
      "providerStates": [
        {
          "name": "I am a System Admin"
        }
      ],
      "request": {
        "body": {
          "content": {
            "firmId": 1,
            "piiAmount": 254,
            "piiExpiry": "20/01/2025",
            "piiReceived": "20/01/2020",
            "piiRequested": "10/01/2020"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Accept": [
            "application/json"
          ],
          "Content-Type": [
            "application/json"
          ],
          "OPG-Bypass-Membrane": [
            "1"
          ],
          "X-XSRF-TOKEN": [
            "abcde"
          ]
        },
        "matchingRules": {
          "body": {
            "$.firmId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.piiAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.piiExpiry": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.piiReceived": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.piiRequested": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "X-XSRF-TOKEN": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "PUT",
        "path": "/supervision-api/v1/firms/1/indemnity-insurance"
      },
      "response": {
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "A request to get pro teams",
      "pending": false,
      "providerStates": [
        {
          "name": "Pro team with members exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/supervision-api/v1/teams",
        "query": {
          "type": [
            "pro"
          ]
        }
      },
      "response": {
        "body": {
          "content": [
            {
              "displayName": "string",
              "id": 1,
              "members": [
                {
                  "displayName": "string",
                  "id": 1,
                  "name": "string"
                }
              ],
              "name": "string"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].displayName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].members": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].members[*].displayName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].members[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].members[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "2.4.2"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "mockserver": "1.2.16",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "sirius"
  }
}