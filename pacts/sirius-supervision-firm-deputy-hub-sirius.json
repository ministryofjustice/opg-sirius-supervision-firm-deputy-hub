      "response": {
        "body": {
          "displayName": "Colin Case",
          "id": 1,
          "roles": [
            "Case Manager"
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.displayName": {
            "match": "type"
          },
          "$.body.id": {
            "match": "type"
          },
          "$.body.roles": {
            "match": "type",
            "min": 1
          }
        },
        "status": 200
      }
